<!DOCTYPE html>
<html lang="ur" dir="ltr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>KK Product Catalog</title>
<style>
  :root{
    --brand:#0b6e4f; --brand-dark:#075c41; --bg:#f5f7f6;
    --card:#ffffff; --text:#1f2937; --muted:#6b7280; --border:#e5e7eb;
    --accent:#f59e0b; --danger:#dc2626;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family:'Segoe UI', system-ui, -apple-system, sans-serif;
    background:var(--bg); color:var(--text); padding-bottom:90px;
  }
  header{
    background:var(--brand); color:#fff; padding:14px 16px;
    position:sticky; top:0; z-index:50; box-shadow:0 2px 8px rgba(0,0,0,.15);
  }
  header h1{font-size:18px; font-weight:600; margin-bottom:10px;}
  .search-wrap{position:relative;}
  .search-wrap input{
    width:100%; padding:12px 40px 12px 14px; border-radius:10px;
    border:none; font-size:15px; outline:none;
  }
  .search-wrap .clear{
    position:absolute; right:10px; top:50%; transform:translateY(-50%);
    background:none; border:none; font-size:20px; color:#999; cursor:pointer;
    display:none;
  }
  .stats{
    font-size:12px; opacity:.85; margin-top:8px;
  }

  .container{padding:12px; max-width:1200px; margin:0 auto;}

  .product-list{display:grid; gap:10px;}
  .product{
    background:var(--card); border-radius:12px; padding:14px;
    display:flex; justify-content:space-between; align-items:center;
    box-shadow:0 1px 4px rgba(0,0,0,.06); border:1px solid var(--border);
    transition:transform .1s;
  }
  .product:active{transform:scale(.995);}
  .product-info{flex:1; min-width:0; padding-right:10px;}
  .product-name{font-size:14px; font-weight:600; line-height:1.3; word-wrap:break-word;}
  .product-meta{
    display:flex; gap:12px; margin-top:6px; font-size:12px; color:var(--muted);
  }
  .product-code{background:#eef2ff; color:#3730a3; padding:2px 8px; border-radius:6px; font-weight:600;}
  .product-rate{background:#ecfdf5; color:var(--brand); padding:2px 8px; border-radius:6px; font-weight:700;}
  .add-btn{
    background:var(--brand); color:#fff; border:none; border-radius:50%;
    width:42px; height:42px; font-size:22px; cursor:pointer; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
  }
  .add-btn:active{background:var(--brand-dark);}
  .add-btn.in-cart{background:var(--accent);}

  .empty{text-align:center; padding:40px 20px; color:var(--muted);}

  /* Cart bottom bar */
  .cart-bar{
    position:fixed; bottom:0; left:0; right:0; background:#fff;
    border-top:1px solid var(--border); padding:12px 16px;
    display:flex; justify-content:space-between; align-items:center;
    box-shadow:0 -4px 12px rgba(0,0,0,.08); z-index:60; cursor:pointer;
  }
  .cart-bar-info{display:flex; flex-direction:column;}
  .cart-bar-info small{color:var(--muted); font-size:12px;}
  .cart-bar-info strong{color:var(--brand); font-size:18px;}
  .cart-bar button{
    background:var(--brand); color:#fff; border:none;
    padding:12px 24px; border-radius:10px; font-size:15px; font-weight:600; cursor:pointer;
  }

  /* Modal */
  .modal{
    position:fixed; inset:0; background:rgba(0,0,0,.55); display:none;
    z-index:100; align-items:flex-end;
  }
  .modal.show{display:flex;}
  .modal-content{
    background:#fff; width:100%; max-height:90vh; border-radius:16px 16px 0 0;
    padding:18px; overflow-y:auto; animation:slideUp .25s ease;
  }
  @keyframes slideUp{from{transform:translateY(100%);} to{transform:translateY(0);}}
  .modal-header{display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;}
  .modal-header h2{font-size:17px; font-weight:700;}
  .close-x{background:none; border:none; font-size:26px; color:var(--muted); cursor:pointer;}

  .cart-item{
    display:flex; align-items:center; gap:10px; padding:10px 0;
    border-bottom:1px solid var(--border);
  }
  .cart-item-info{flex:1; min-width:0;}
  .cart-item-info .name{font-size:13px; font-weight:600;}
  .cart-item-info .rate{font-size:12px; color:var(--muted);}
  .qty-controls{display:flex; align-items:center; gap:6px;}
  .qty-controls button{
    width:28px; height:28px; border-radius:6px; border:1px solid var(--border);
    background:#fff; cursor:pointer; font-size:16px; font-weight:700;
  }
  .qty-controls input{
    width:48px; text-align:center; padding:5px; border:1px solid var(--border);
    border-radius:6px; font-size:13px; font-weight:600;
  }
  .line-total{font-size:13px; font-weight:700; color:var(--brand); min-width:60px; text-align:right;}
  .remove-btn{background:none; border:none; color:var(--danger); font-size:18px; cursor:pointer;}

  .totals{display:flex; justify-content:space-between; padding:14px 0; font-size:16px; font-weight:700;}
  .totals span:last-child{color:var(--brand);}

  .field{margin-bottom:12px;}
  .field label{display:block; font-size:12px; font-weight:600; color:var(--muted); margin-bottom:5px;}
  .field input, .field textarea{
    width:100%; padding:11px 12px; border:1px solid var(--border);
    border-radius:9px; font-size:14px; outline:none; font-family:inherit;
  }
  .field input:focus, .field textarea:focus{border-color:var(--brand);}

  .btn-primary{
    width:100%; background:var(--brand); color:#fff; border:none;
    padding:14px; border-radius:10px; font-size:15px; font-weight:700;
    cursor:pointer; margin-top:8px;
  }
  .btn-primary:disabled{opacity:.6; cursor:not-allowed;}
  .btn-secondary{
    width:100%; background:#fff; color:var(--brand); border:1px solid var(--brand);
    padding:12px; border-radius:10px; font-size:14px; font-weight:600;
    cursor:pointer; margin-top:8px;
  }

  .success-msg{
    text-align:center; padding:24px 0;
  }
  .success-msg .check{
    width:64px; height:64px; border-radius:50%; background:#ecfdf5;
    color:var(--brand); display:flex; align-items:center; justify-content:center;
    font-size:34px; margin:0 auto 14px;
  }
  .success-msg h3{font-size:18px; margin-bottom:8px;}
  .success-msg p{color:var(--muted); font-size:13px; margin-bottom:16px;}
  .order-id{background:#f3f4f6; padding:8px 14px; border-radius:8px; font-family:monospace; font-size:13px; display:inline-block;}

  .toast{
    position:fixed; bottom:100px; left:50%; transform:translateX(-50%) translateY(20px);
    background:#1f2937; color:#fff; padding:10px 20px; border-radius:10px;
    font-size:13px; opacity:0; pointer-events:none; transition:all .25s; z-index:200;
  }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}

  @media(min-width:768px){
    .product-list{grid-template-columns:1fr 1fr;}
    .modal{justify-content:center; align-items:center;}
    .modal-content{max-width:500px; border-radius:16px; max-height:85vh;}
  }
</style>
</head>
<body>

<header>
  <h1>🛒 KK Product Catalog</h1>
  <div class="search-wrap">
    <input id="searchInput" type="text" placeholder="سرچ کریں: نام، کوڈ یا قیمت..." autocomplete="off" />
    <button class="clear" id="clearBtn">&times;</button>
  </div>
  <div class="stats" id="stats">Loading...</div>
</header>

<div class="container">
  <div class="product-list" id="productList"></div>
  <div class="empty" id="emptyState" style="display:none;">
    <p>😕 کوئی پروڈکٹ نہیں ملی</p>
  </div>
</div>

<!-- Fixed Cart Bar -->
<div class="cart-bar" id="cartBar" style="display:none;">
  <div class="cart-bar-info">
    <small id="cartCountLabel">0 items</small>
    <strong id="cartTotalLabel">Rs 0</strong>
  </div>
  <button id="viewCartBtn">View Cart ➔</button>
</div>

<!-- Cart Modal -->
<div class="modal" id="cartModal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>🛍️ Your Order</h2>
      <button class="close-x" onclick="closeModal('cartModal')">&times;</button>
    </div>
    <div id="cartItemsContainer"></div>
    <div id="cartTotalsContainer"></div>
    <div id="checkoutForm">
      <div class="field">
        <label>Customer Name *</label>
        <input type="text" id="customerName" placeholder="آپ کا نام" />
      </div>
      <div class="field">
        <label>Phone Number *</label>
        <input type="tel" id="customerPhone" placeholder="03XX-XXXXXXX" />
      </div>
      <div class="field">
        <label>Address / Notes (Optional)</label>
        <textarea id="customerNotes" rows="2" placeholder="پتہ یا کوئی ہدایت..."></textarea>
      </div>
      <button class="btn-primary" id="placeOrderBtn" onclick="placeOrder()">✅ Confirm Order</button>
    </div>
    <div id="orderSuccess" style="display:none;"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- ============ Firebase SDK ============ -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {
  getFirestore, collection, addDoc, serverTimestamp
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

/* =========================================================
   🔥 اپنی Firebase config یہاں ڈالیں
   (Firebase Console → Project Settings → Your apps)
   ========================================================= */
const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "YOUR_PROJECT.firebaseapp.com",
  projectId: "YOUR_PROJECT_ID",
  storageBucket: "YOUR_PROJECT.appspot.com",
  messagingSenderId: "YOUR_SENDER_ID",
  appId: "YOUR_APP_ID"
};

const fbApp = initializeApp(firebaseConfig);
const db = getFirestore(fbApp);

/* =========================================================
   📦 پروڈکٹ ڈیٹا (آپ کی Excel شیٹ سے)
   ========================================================= */
const PRODUCTS = [
  {code:49,name:"20 ml POLISH B 50 OFF",rate:230},
  {code:55,name:"50 ml WHITE LIQUID",rate:120},
  {code:56,name:"100 ml WHITE LIQUID",rate:200},
