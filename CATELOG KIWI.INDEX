  {code:87,name:"REVIVE ALL 250ml (C)",rate:800},
  {code:88,name:"RABBITE BLUE 100ml NP",rate:180},
  {code:89,name:"AUTO SHINE TIN 220gm",rate:650},
  {code:92,name:"KITCHEN CLEANER 500 ml",rate:650},
  {code:98,name:"INS OIL SPRAY 450 ml",rate:620},
  {code:99,name:"WHITE PHENYL 450 ml",rate:625},
  {code:101,name:"BLEACH POWER 500ML 70 SAVE",rate:470},
  {code:103,name:"INSECT POWDER 100gm",rate:400},
  {code:104,name:"LED REFILL 45ml",rate:440},
  {code:105,name:"LED HEATER + REFILL 45ml",rate:625},
  {code:106,name:"MOSQUITO COIL PACK",rate:150},
  {code:107,name:"REPELLENT LOTION 60ml",rate:250},
  {code:108,name:"WHITE PHENYL 225ml",rate:475},
  {code:116,name:"90mL B POLISH 750/=",rate:750},
  {code:118,name:"STARCH SPRAY 100 SAVE NEW",rate:875},
  {code:119,name:"45 ml BLACK (CITY)",rate:445},
  {code:123,name:"20 ml B POLISH (CITY)",rate:230},
  {code:132,name:"75 ml B LIQUID/450",rate:450},
  {code:133,name:"75 ml D LIQUID/ 450",rate:450},
  {code:134,name:"75 ml N LIQUID=/450",rate:450},
  {code:136,name:"45 ml DTANCITY)",rate:445},
  {code:137,name:"TUBE NEAUTRAL 430/=",rate:430},
  {code:141,name:"SURFACE FLORAL 400/=",rate:400},
  {code:142,name:"SURFACE 500ml(LEMON)",rate:400},
  {code:143,name:"SURFACE LEVENDER",rate:400},
  {code:144,name:"SURFACE 500ml(PINE)",rate:400},
  {code:147,name:"90 ml (D) POLISH 750/=",rate:750},
  {code:151,name:"TUBE 45 ml D 430/=",rate:430},
  {code:152,name:"300 GM BLACK CAT LARG",rate:480},
  {code:153,name:"PRICKLY HEAT POWDER 125GM",rate:195},
  {code:154,name:"20ml D POLISH (CITY)",rate:230},
  {code:156,name:"TUBE 45 ml B 430/=",rate:430},
  {code:157,name:"TUBE WHITE 430/=",rate:430},
  {code:161,name:"SURFACE FLORAL 200ML",rate:170},
  {code:170,name:"DISHWASH LIQUID 475ML",rate:300},
  {code:175,name:"200 ml WHITE LIQUID",rate:290},
  {code:177,name:"RABBIT BLUE 200 ML",rate:275},
  {code:201,name:"SHOE SHINER NEATURAL 370/=",rate:370},
  {code:202,name:"GLEANT DISINFACT ALL P. SAPRAY 500 ml",rate:700},
  {code:204,name:"AUTO SHINE TUBE 83GM 40 SAVE",rate:640},
  {code:205,name:"WHITE LIQ 100ML 25SAVE",rate:200},
  {code:206,name:"45 ML POLISH BLACK 100 SAVE",rate:345},
  {code:208,name:"BLEACH LAVN 500ML 50 SAVE",rate:500},
  {code:209,name:"SHOE SHANIR TWIN 100 SAVE",rate:640},
  {code:210,name:"POWDER NEW VINTAGE 70 GM",rate:185},
  {code:211,name:"GLASS CLEANER 120 SAVE",rate:700},
  {code:212,name:"75ML LIQ N 100 OFF",rate:450},
  {code:213,name:"75ML LIQ D 100 OFF",rate:450},
  {code:214,name:"75ML LIQ B 100 OFF",rate:450},
  {code:215,name:"SHOE SHANIR N TWIN 100 SAVE",rate:640},
  {code:216,name:"20ML POLISH D 50 OFF",rate:230},
  {code:218,name:"DISHWASH 100 OFF",rate:300},
