  {code:222,name:"GLASS LAVENDER 120 SAVE",rate:700},
  {code:224,name:"INS AEROSOL SPRAY 100 OFF",rate:500},
  {code:225,name:"SURFACE LAVENDER 1LTR",rate:650},
  {code:226,name:"SURFACE FLORAL 1LTR",rate:650},
  {code:228,name:"STRACH SPRAY WIN700",rate:875},
  {code:229,name:"NEW STEEL CLEANER 500ML",rate:800},
  {code:230,name:"NEW KITCHEN CLEANER",rate:800},
  {code:231,name:"NEW REVALL R 250ML",rate:800},
  {code:232,name:"NEW REVALL C 250ML",rate:800},
  {code:233,name:"NEW REVALL A 250ML",rate:800},
  {code:234,name:"NEW DRANEX",rate:750},
  {code:235,name:"NEW RABIT 100ML",rate:215},
  {code:236,name:"NEW RABIT 200ML",rate:325},
  {code:237,name:"NEW BLEACH R 500ML",rate:600},
  {code:238,name:"NEW BLEACH LEV 500ML",rate:600},
  {code:239,name:"NEW WHITE PHENYL 225ML",rate:600},
  {code:240,name:"NEW 2.75 LTR WHITE PHENYL 100 OFF",rate:550},
  {code:241,name:"NEW WHITE PHENYL450ML",rate:800},
  {code:242,name:"NEW AUTO SHINE TIN",rate:800},
  {code:244,name:"NEW 300GM BLACK CAT",rate:550},
  {code:245,name:"NEW 90ML DAKTAN POLISH",rate:900},
  {code:246,name:"NEW 90ML BLACK POLISH",rate:900},
  {code:247,name:"NEW 45 ML BLACK POLISH",rate:500},
  {code:249,name:"NEW 20ML BLACK POLISH",rate:270},
  {code:250,name:"NEW 20ML DAKTAN POLISH",rate:270},
  {code:251,name:"NEW TOLIT CLEANER 250ML",rate:325},
  {code:252,name:"NEW TOLIT CLEANER 500ML",rate:550},
  {code:253,name:"NEW SURFACE FLORAL 500ML",rate:500},
  {code:254,name:"NEW SURFACE LEV 500ML",rate:500},
  {code:255,name:"NEW SURFACE LEM 500ML",rate:500},
  {code:256,name:"NEW SURFACE PINE 500ML",rate:500},
  {code:257,name:"NEW BRASS 100ML",rate:550},
  {code:258,name:"NEW BRASS 200ML",rate:900},
  {code:259,name:"GLASS CLEANER REG NEW",rate:850},
  {code:260,name:"GLASS CLEANER LEV NEW",rate:850},
  {code:261,name:"GLASS CLEANER ALL PURPOSE NEW",rate:850},
  {code:262,name:"75 LIQ N 550",rate:550},
  {code:264,name:"75 LIQ B 550",rate:550},
  {code:265,name:"SHOE SHINE B 450",rate:450},
  {code:266,name:"SHOE SHINE N 450",rate:450},
  {code:267,name:"TUBE 45ML B /500",rate:500},
  {code:268,name:"TUBE 45ML D /500",rate:500},
  {code:272,name:"TUBE 45ML NEUTRAL /500",rate:500}
];

/* =========================================================
   🧠 ایپلیکیشن لاجک
   ========================================================= */
let cart = {};           // { code: qty }
let filtered = [...PRODUCTS];
const currency = n => "Rs " + n.toLocaleString('en-PK');

const $ = id => document.getElementById(id);
const productListEl = $('productList');
const emptyStateEl  = $('emptyState');
const searchInput   = $('searchInput');
const clearBtn      = $('clearBtn');
const statsEl       = $('stats');
const cartBar       = $('cartBar');
const cartModal     = $('cartModal');

/* ---------- Render Products ---------- */
function renderProducts(list){
  productListEl.innerHTML = '';
  if(list.length === 0){
    emptyStateEl.style.display = 'block';
    return;
  }
  emptyStateEl.style.display = 'none';
  const frag = document.createDocumentFragment();
  list.forEach(p => {
    const inCart = cart[p.code] ? 'in-cart' : '';
    const card = document.createElement('div');
    card.className = 'product';
    card.innerHTML = `
      <div class="product-info">
        <div class="product-name">${p.name}</div>
        <div class="product-meta">
          <span class="product-code">#${p.code}</span>
          <span class="product-rate">${currency(p.rate)}</span>
        </div>
      </div>
      <button class="add-btn ${inCart}" onclick="addToCart(${p.code})" title="Add">+</button>
    `;
    frag.appendChild(card);
  });
  productListEl.appendChild(frag);
  statsEl.textContent = `${list.length} product(s) found`;
}

/* ---------- Search ---------- */
searchInput.addEventListener('input', e => {
  const q = e.target.value.trim().toLowerCase();
  clearBtn.style.display = q ? 'block' : 'none';
  if(!q){
    filtered = [...PRODUCTS];
  } else {
    filtered = PRODUCTS.filter(p =>
      p.name.toLowerCase().includes(q) ||
      String(p.code).includes(q) ||
      String(p.rate).includes(q)
    );
  }
  renderProducts(filtered);
});

clearBtn.addEventListener('click', () => {
  searchInput.value = '';
  clearBtn.style.display = 'none';
  filtered = [...PRODUCTS];
  renderProducts(filtered);
});

/* ---------- Cart Logic ---------- */
function addToCart(code){
  cart[code] = (cart[code] || 0) + 1;
  toast('✅ Added to cart');
  updateCartUI();
  renderProducts(filtered);
}

function changeQty(code, delta){
  cart[code] = (cart[code] || 0) + delta;
  if(cart[code] <= 0) delete cart[code];
  updateCartUI();
  renderProducts(filtered);
}

function removeFromCart(code){
  delete cart[code];
  updateCartUI();
  renderProducts(filtered);
}

function setQty(code, val){
  const q = parseInt(val);
  if(isNaN(q) || q <= 0) delete cart[code];
  else cart[code] = q;
  updateCartUI();
  renderProducts(filtered);
}

function cartTotal(){
  return Object.entries(cart).reduce((sum,[code,qty]) => {
    const p = PRODUCTS.find(x => x.code === +code);
    return sum + (p ? p.rate * qty : 0);
  }, 0);
}

function cartCount(){
  return Object.values(cart).reduce((a,b)=>a+b,0);
}

function updateCartUI(){
  const count = cartCount();
  const total = cartTotal();
  if(count === 0){
    cartBar.style.display = 'none';
  } else {
    cartBar.style.display = 'flex';
    $('cartCountLabel').textContent = `${count} item(s)`;
    $('cartTotalLabel').textContent = currency(total);
  }
  renderCartModal();
}

/* ---------- Cart Modal ---------- */
function renderCartModal(){
  const container = $('cartItemsContainer');
  const totals = $('cartTotalsContainer');
  const entries = Object.entries(cart);
  if(entries.length === 0){
    container.innerHTML = '<div class="empty">🛒 Cart is empty</div>';
    totals.innerHTML = '';
    $('checkoutForm').style.display = 'none';
    return;
  }
  $('checkoutForm').style.display = 'block';
  container.innerHTML = entries.map(([code,qty]) => {
    const p = PRODUCTS.find(x => x.code === +code);
    return `
      <div class="cart-item">
        <div class="cart-item-info">
          <div class="name">${p.name}</div>
          <div class="rate">#${p.code} — ${currency(p.rate)}</div>
        </div>
        <div class="qty-controls">
          <button onclick="changeQty(${p.code},-1)">−</button>
          <input type="number" min="1" value="${qty}" onchange="setQty(${p.code}, this.value)" />
          <button onclick="changeQty(${p.code},1)">+</button>
        </div>
        <div class="line-total">${currency(p.rate*qty)}</div>
        <button class="remove-btn" onclick="removeFromCart(${p.code})">✕</button>
      </div>
    `;
  }).join('');
  totals.innerHTML = `<div class="totals"><span>Total</span><span>${currency(cartTotal())}</span></div>`;
}

function openModal(){
  cartModal.classList.add('show');
  renderCartModal();
  $('orderSuccess').style.display = 'none';
  $('checkoutForm').style.display = Object.keys(cart).length ? 'block' : 'none';
}
function closeModal(id){
  $(id).classList.remove('show');
}
$('cartBar').addEventListener('click', e => {
  if(e.target.id !== 'viewCartBtn' && e.target.closest('#viewCartBtn')) return;
  openModal();
});
$('viewCartBtn').addEventListener('click', e => {
  e.stopPropagation(); openModal();
});
cartModal.addEventListener('click', e => {
  if(e.target === cartModal) closeModal('cartModal');
});

/* ---------- Place Order (Firebase) ---------- */
async function placeOrder(){
  const name  = $('customerName').value.trim();
  const phone = $('customerPhone').value.trim();
  const notes = $('customerNotes').value.trim();

  if(!name || !phone){
    toast('⚠️ Name and Phone are required');
    return;
  }
  if(Object.keys(cart).length === 0){
    toast('⚠️ Cart is empty');
    return;
  }

  const btn = $('placeOrderBtn');
  btn.disabled = true;
  btn.textContent = 'Placing order...';

  const items = Object.entries(cart).map(([code,qty]) => {
    const p = PRODUCTS.find(x => x.code === +code);
    return { code:p.code, name:p.name, rate:p.rate, qty, lineTotal:p.rate*qty };
  });
  const total = cartTotal();

  try{
    const docRef = await addDoc(collection(db, "orders"), {
      customer: { name, phone, notes },
      items,
      total,
      itemCount: items.length,
      status: "pending",
      createdAt: serverTimestamp(),
      source: "web_catalog"
    });

    // Success
    $('checkoutForm').style.display = 'none';
    $('cartItemsContainer').innerHTML = '';
    $('cartTotalsContainer').innerHTML = '';
    const success = $('orderSuccess');
    success.style.display = 'block';
    success.innerHTML = `
      <div class="success-msg">
        <div class="check">✓</div>
        <h3>Order Placed Successfully!</h3>
        <p>آپ کا آرڈر موصول ہو گیا ہے۔ ہم جلد رابطہ کریں گے۔</p>
        <div class="order-id">Order ID: ${docRef.id.slice(0,10).toUpperCase()}</div>
      </div>
      <button class="btn-secondary" onclick="whatsappShare('${docRef.id}')">📱 Share on WhatsApp</button>
      <button class="btn-secondary" onclick="resetAfterOrder()">🛍️ Continue Shopping</button>
    `;
    // Prepare WhatsApp link data
    window._lastOrder = { id: docRef.id, name, phone, items, total };
  } catch(err){
    console.error(err);
    toast('❌ Error: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.textContent = '✅ Confirm Order';
  }
}

function whatsappShare(orderId){
  const o = window._lastOrder;
  if(!o) return;
  let msg = `*New Order* #${orderId.slice(0,10).toUpperCase()}\n`;
  msg += `👤 ${o.name}\n📞 ${o.phone}\n\n`;
  o.items.forEach(i => {
    msg += `• ${i.name} × ${i.qty} = Rs ${i.lineTotal}\n`;
  });
  msg += `\n*Total: Rs ${o.total}*`;
  // ⬇️ اپنا واٹس ایپ نمبر یہاں ڈالیں (country code کے ساتھ، بغیر + کے)
  const myNumber = "923001234567";
  window.open(`https://wa.me/${myNumber}?text=${encodeURIComponent(msg)}`, '_blank');
}

function resetAfterOrder(){
  cart = {};
  updateCartUI();
  renderProducts(filtered);
  closeModal('cartModal');
  $('customerName').value = '';
  $('customerPhone').value = '';
  $('customerNotes').value = '';
}

/* ---------- Toast ---------- */
let toastTimer;
function toast(msg){
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
}

/* ---------- Init ---------- */
renderProducts(filtered);
updateCartUI();

// expose to global for inline onclick
window.addToCart = addToCart;
window.changeQty = changeQty;
window.removeFromCart = removeFromCart;
window.setQty = setQty;
window.placeOrder = placeOrder;
window.whatsappShare = whatsappShare;
window.resetAfterOrder = resetAfterOrder;
window.closeModal = closeModal;
</script>
</body>
</html>
